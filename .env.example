# Base URL of the target site (no trailing slash), e.g. https://otakudesu.blog
TARGET_BASE_URL=https://otakudesu.blog

# Optional: Cloudflare Worker forward-proxy prefix, e.g. https://your-worker.workers.dev/?url=
# If unset, requests go directly to TARGET_BASE_URL with browser-like headers.
CF_PROXY_URL=https://anipeoxy.xaisyndicate1337.workers.dev

# Optional: request timeout in milliseconds
REQUEST_TIMEOUT_MS=20000
